<header>
    <h1>Contatos dos Campus do IFPE</h1>
    <p>Encontre rapidamente os contatos dos campus aqui!</p>

    <a href="/contatos/novo">
        <button>Novo Contato</button>
    </a>
</header>

<main>

    <div class="pesquisa">
        <input
            type="text"
            id="pesquisa"
            placeholder="🔍 Pesquisar campus..."
        >
    </div>

    <div class="campi">

        {{#each contatos}}

        <div class="campus">

            <h2>🏫 {{campus}}</h2>

            <p>📞 {{telefone}}</p>

            <p>✉️ {{email}}</p>

            <div class="acoes">

                <a href="/contatos/editar/{{id}}">
                    <button class="editar">
                        Editar
                    </button>
                </a>

                <form action="/contatos/deletar/{{id}}" method="POST">

                    <button class="excluir" type="submit">
                        Excluir
                    </button>

                </form>

            </div>

        </div>

        {{/each}}

    </div>

</main>

<script src="/js/contatos.js"></script>
